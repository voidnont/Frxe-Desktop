{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frxe Desktop",
  "version": "1.2.4",
  "identifier": "app.frxe.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Frxe",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#070b12"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage", "dmg"],
    "publisher": "void",
    "category": "Music",
    "shortDescription": "Frxe Desktop Music Player",
    "longDescription": "Frxe Desktop brings the native Frxe music experience to Windows, Linux and macOS.",
    "resources": [
      "resources/runtime/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
